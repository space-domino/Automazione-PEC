# syntax=docker/dockerfile:1

# ---------- base ----------
FROM node:22-slim AS base
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
ENV NEXT_TELEMETRY_DISABLED=1

# ---------- deps ----------
FROM base AS deps
COPY package.json package-lock.json ./
COPY db/schema.prisma ./db/schema.prisma
RUN npm ci

# ---------- build ----------
FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npx prisma generate --schema db/schema.prisma
RUN npm run build

# ---------- runner ----------
FROM base AS runner
ENV NODE_ENV=production
RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs nextjs

# Output standalone di Next
COPY --from=build --chown=1001:1001 /app/.next/standalone ./
COPY --from=build --chown=1001:1001 /app/.next/static ./.next/static
COPY --from=build --chown=1001:1001 /app/public ./public

# Prisma Client + engine (il tracing standalone non sempre li include)
COPY --from=build --chown=1001:1001 /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=build --chown=1001:1001 /app/node_modules/@prisma/client ./node_modules/@prisma/client
COPY --from=build --chown=1001:1001 /app/db ./db

USER 1001
EXPOSE 3000
ENV PORT=3000 HOSTNAME=0.0.0.0
CMD ["node", "server.js"]
