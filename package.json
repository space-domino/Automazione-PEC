{
  "name": "domain-reselling-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "prisma": {
    "schema": "db/schema.prisma",
    "seed": "tsx db/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker:dev": "tsx watch worker/index.ts",
    "worker:start": "tsx worker/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx db/seed.ts",
    "db:studio": "prisma studio",
    "create-user": "tsx scripts/create-user.ts",
    "import:spacedomino": "tsx scripts/import-spacedomino-catalog.ts",
    "backup": "tsx scripts/backup.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "set-pec-template": "tsx scripts/set-pec-template.ts",
    "check:storefront": "tsx scripts/check-storefront.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/client": "^6.2.1",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.5",
    "chardet": "^2.2.0",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.2",
    "iconv-lite": "^0.7.3",
    "imapflow": "^2.0.0",
    "ioredis": "^5.4.2",
    "mailparser": "^3.9.23",
    "mysql2": "^3.24.4",
    "next": "^15.1.4",
    "next-auth": "^5.0.0-beta.25",
    "nodemailer": "^8.0.11",
    "pino": "^9.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.49.1",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
