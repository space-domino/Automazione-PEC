# =============================================================================
#  Domain Reselling Platform — .env.example
#  Copia in `.env` e compila. NON committare mai `.env`.
#  Ogni valore obbligatorio è validato all'avvio da lib/env.ts (fail-fast).
# =============================================================================

# ----- Ambiente -----
NODE_ENV=development

# ----- Domini pubblici (usati da Caddy e da Next) -----
# In locale puoi lasciare i default; in produzione metti i tuoi.
APP_DOMAIN=app.localhost
PUBLIC_DOMAIN=localhost
N8N_DOMAIN=n8n.localhost
ACME_EMAIL=you@example.com
# URL assoluto della dashboard (Auth.js) e base pubblica per link/landing
AUTH_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# ----- Database (Postgres nel container) -----
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=app
# In Docker l'host è "postgres"; in dev locale fuori Docker usa "localhost:5432"
DATABASE_URL=postgresql://app:change-me-strong@localhost:5432/app?schema=public

# ----- Redis (coda BullMQ + cache) -----
# In Docker l'host è "redis"; in dev locale usa "localhost:6379"
REDIS_URL=redis://localhost:6379

# ----- Segreti applicativi (genera con i comandi nel README / Blocco 3) -----
# openssl rand -base64 32
AUTH_SECRET=generate-32-bytes-base64
# openssl rand -base64 32  -> chiave AES-256-GCM per dati sensibili (authcode, TOTP)
DATA_ENCRYPTION_KEY=generate-32-bytes-base64
# openssl rand -base64 32  -> HMAC per token opt-out / delivery
TOKEN_SIGNING_KEY=generate-32-bytes-base64

# ----- Storage locale (CSV import) -----
# In Docker montato su volume: /app/data/uploads
UPLOADS_DIR=./data/uploads
MAX_UPLOAD_MB=25

# =============================================================================
#  Servizi esterni — NON obbligatori per la Milestone 1.
#  Compilali quando arrivi alla milestone indicata (sezione I.3 del design).
# =============================================================================

# ----- AI (Milestone 3) -----
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ----- Storefront spacedomino.it (Milestone 7) -----
# Base pubblica del sito: usata per costruire gli URL delle landing /domini/<slug>.
SPACEDOMINO_BASE_URL=https://spacedomino.it
# Connessione MySQL allo storefront per il connettore catalogo (push offerte su
# `products`, in futuro pull ordini). LASCIARE VUOTA finché non hai creato un
# utente MySQL dedicato con grant minimi (SELECT su orders/order_items,
# INSERT/UPDATE/DELETE solo su products). Se vuota, il connettore è disattivato
# (no-op tracciato a log) e la piattaforma funziona comunque.
# Esempio: mysql://drp_connector:PASS@<HOST_VPS>:3306/spacedomino
SPACEDOMINO_DATABASE_URL=
# Origini ammesse per l'API pubblica /api/public/* (CSV, senza slash finale).
PUBLIC_CORS_ORIGINS=https://spacedomino.it

# ----- Stripe (Milestone 8) -----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ----- PEC via SMTP + IMAP (Milestone 9) -----
# Casella PEC del gestore (Aruba, Namirial, ...). SMTP per inviare, IMAP per
# leggere le ricevute (accettazione / avvenuta consegna) via daticert.xml.
# Finché SMTP_HOST/USER/PASS sono vuoti, `features.pec` = false: compose funziona
# (bozze), invio e poll ricevute sono no-op.
PEC_SMTP_HOST=
PEC_SMTP_PORT=465          # 465 = TLS implicito · 587 = STARTTLS
PEC_SMTP_USER=
PEC_SMTP_PASS=
PEC_IMAP_HOST=
PEC_IMAP_PORT=993
PEC_IMAP_USER=
PEC_IMAP_PASS=
# Se la password contiene `$` mettila qui in base64 invece che in PEC_*_PASS:
# dotenv-expand (@next/env) altrimenti trasforma `Pa$$w0rd` in `Pa$`. Ha precedenza
# su PEC_*_PASS. Genera con:  node -e "console.log(Buffer.from('LA_PASSWORD').toString('base64'))"
PEC_SMTP_PASS_B64=
PEC_IMAP_PASS_B64=
# Mittente mostrato nelle PEC (di norma coincide con PEC_SMTP_USER). Vuoto = usa l'utente SMTP.
PEC_FROM_ADDRESS=

# ----- Backup off-site S3-compatibile (Milestone 12) -----
# `npm run backup` fa pg_dump | gzip -> PUT su bucket (firma SigV4, nessuna dipendenza).
# Compatibile con AWS S3, MinIO, Backblaze B2, Cloudflare R2, Wasabi.
BACKUP_S3_ENDPOINT=       # es. https://s3.eu-central-1.amazonaws.com  oppure  https://minio.tuodominio.it
BACKUP_S3_REGION=us-east-1
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_BUCKET=
BACKUP_RETENTION_DAYS=30  # informativo: la pulizia si fa con una lifecycle policy sul bucket

# ----- Error tracking (Milestone 12) -----
SENTRY_DSN=
GLITCHTIP_DSN=

# ----- Notifiche/alert via n8n (Milestone 12) -----
# Se valorizzato, ogni alert (raiseAlert / monitoring.scan) viene inoltrato qui.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=       # opzionale: inviato come `Authorization: Bearer ...`
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
